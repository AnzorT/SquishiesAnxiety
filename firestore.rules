rules_version = '2';

// Deploy via the Firebase Console (Firestore Database > Rules) or
// `firebase deploy --only firestore:rules`. Not applied automatically —
// nothing in this repo has credentials to push it for you.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only ever read/write their own profile document.
    // NOTE: coins/ownedIds are written straight from the client — there's
    // no Cloud Function validating *how much* a client credits itself, so
    // treat this as prototype-grade trust, not a cheat-proof economy.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // generationCredits pays for real Tripo API spend, so — unlike
      // coins/ownedIds above — the client is never allowed to touch it
      // directly; only generateCustomModel (admin SDK, bypasses rules) may
      // spend or refund it, and a purchase is reconciled by hand for now by
      // setting it from the Firebase console/admin SDK.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['generationCredits']);
      // A fresh profile may only ever start with its one free generation
      // (or none set, which the Cloud Function also treats as 1) — never a
      // self-granted stack of them.
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('generationCredits' in request.resource.data) || request.resource.data.generationCredits == 1);

      // Player-made creatures (image-to-3D via the creator flow). Fully
      // owned by that user — nobody else reads or writes them.
      match /customCreatures/{creatureId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // The creature catalog is shared/global, curated server-side only (see
    // functions/index.js's one-time migration) — no client ever writes here,
    // including create; the app used to self-seed a starter catalog on
    // first run, but that path is gone now that the real catalog exists.
    match /creatures/{creatureId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Server-driven config (currently just the generation price) — read by
    // every signed-in client, edited by hand from the Firebase console (same
    // "reconciled by hand" pattern as users/{uid}.generationCredits above).
    match /config/{doc} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // One-way mailbox: any signed-in user can drop a feedback note bearing
    // their own uid, nobody can read, edit, or delete it back out via the
    // client — reading happens from the Firebase console/admin SDK instead.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
