# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo
.expo/
dist/
web-build/

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.cxx/
*.iml
*.hprof
.cxx/

# iOS
ios/Pods/
ios/build/

# macOS
.DS_Store

# Env
.env
*.local

# Firebase service-account keys (full admin access to the project)
*-firebase-adminsdk-*.json

# tools/plush-art: the extracted design and the rendered images (published
# to Firebase by publish.mjs, never bundled with the app)
tools/plush-art/design/
tools/plush-art/out/
# tools/audio: the renderer's raw WAVs (encode.py turns them into assets/audio)
tools/audio/out/
# tools/crib-art: render.mjs's whole-room shots and manifests for check.py
tools/crib-art/out/

# Firebase emulator logs
*-debug.log

# tools/plush-art/serve.mjs writes this preview catalog (art served from the PC)
src/data/devCatalog.js

# Python bytecode caches (tools/icon, tools/audio)
__pycache__/

# tools/shop-art: the design screens decoded from "Squish Squad App.html"
tools/shop-art/design/
