<Project Sdk="Microsoft.NET.Sdk">
  <!-- The native creature rig off Unity: the compiled rig (Creatures/Js, its Gen) and the test scenarios, run with plain
       dotnet against the JS (run.mjs). GEN: where jsc.mjs wrote the compiled scripts (default: the Unity project's). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0162;CS0164;CS0168;CS0219;CS8321;CS1998</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GEN Condition="'$(GEN)' == ''">../../../unity/Assets/Scripts/Creatures/Js/Gen</GEN>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/Assets/Scripts/Creatures/Js/*.cs" />
    <Compile Include="$(GEN)/*.cs" />
    <!-- the drawing side's Unity-free part: the node tree, its parse, the scene compile (Vector), the direct tree -->
    <Compile Include="../../../unity/Assets/Scripts/Vector/*.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Creatures/RigTree.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
