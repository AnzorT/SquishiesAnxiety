<Project Sdk="Microsoft.NET.Sdk">
  <!-- Squish Stack's C# port (unity/Assets/Scripts/Games/Stack) against the JS (src/stack), outside Unity.
       Run fixtures.mjs with node, then this with dotnet run in Release (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- the rules only (the screens and their drawing need Unity and the UI) -->
    <Compile Include="../../../../unity/Assets/Scripts/Games/Stack/Engine.cs;../../../../unity/Assets/Scripts/Games/Stack/Js.cs;../../../../unity/Assets/Scripts/Games/Stack/Levels.cs;../../../../unity/Assets/Scripts/Games/Stack/Road.cs;../../../../unity/Assets/Scripts/Games/Stack/StackXp.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
