<Project Sdk="Microsoft.NET.Sdk">
  <!-- The mini-games' rig stages off Unity (Program.cs): the compiled realm (Creatures/Js, its Gen: the rig with
       tools/rig/sort.html's and hop.html's scripts), Creatures/RigStage.cs driving them, their squishies drawn with the
       reference rasteriser and compared with the app's pages (capture.mjs). GEN: where jsc.mjs wrote the scripts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0162;CS0164;CS0168;CS0219;CS8321;CS1998;CS0649;CS0414</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GEN Condition="'$(GEN)' == ''">../../../unity/Assets/Scripts/Creatures/Js/Gen</GEN>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/Assets/Scripts/Creatures/Js/*.cs" />
    <Compile Include="$(GEN)/*.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Vector/*.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Creatures/RigTree.cs;../../../unity/Assets/Scripts/Creatures/RigStage.cs" />
    <Compile Include="../vector-test/ReferenceRaster.cs;../vector-test/Png.cs" />
    <!-- sortlevel: a real Squish Sort level on the page (SortLevelCheck.cs), drawn with sort-test's Render -->
    <Compile Include="../../../unity/Assets/Scripts/Ui/UiFont.cs;../../../unity/Assets/Scripts/Ui/UiSvg.cs;../../../unity/Assets/Scripts/Ui/AdHook.cs;../../../unity/Assets/Scripts/Audio/Snd.cs;../../../unity/Assets/Scripts/Backend/OfflineWallet.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Ui/Cards/*.cs" Exclude="../../../unity/Assets/Scripts/Ui/Cards/CardPieces.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Ui/Blitz/*.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Anim/*.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Games/Sort/*.cs" Exclude="../../../unity/Assets/Scripts/Games/Sort/SortGame.cs;../../../unity/Assets/Scripts/Games/Sort/SortDoorPiece.cs;../../../unity/Assets/Scripts/Games/Sort/SortHub*.cs;../../../unity/Assets/Scripts/Games/Sort/SortScreen.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Games/Squishdoku/SdGeometry.cs;../../../unity/Assets/Scripts/Games/Squishdoku/SdArt.cs;../../../unity/Assets/Scripts/Games/Squishdoku/SdBlitzCards.cs;../../../unity/Assets/Scripts/Games/Squishdoku/SdSave.cs;../../../unity/Assets/Scripts/Games/Squishdoku/Engine.cs;../../../unity/Assets/Scripts/Games/Squishdoku/Js.cs;../../../unity/Assets/Scripts/Games/Squishdoku/LevelData.g.cs;../../../unity/Assets/Scripts/Games/Squishdoku/Levels.cs;../../../unity/Assets/Scripts/Games/Squishdoku/PlayerXp.cs" />
    <Compile Include="../sort-test/Render.cs" />
    <!-- hoplevel: a real Squish Hop level on the page (HopLevelCheck.cs) -->
    <Compile Include="../../../unity/Assets/Scripts/Games/Hop/*.cs" Exclude="../../../unity/Assets/Scripts/Games/Hop/HopGame.cs;../../../unity/Assets/Scripts/Games/Hop/HopMesh.cs;../../../unity/Assets/Scripts/Games/Hop/HopScreen.cs;../../../unity/Assets/Scripts/Games/Hop/HopScreenModel.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Games/Squishdoku/SdClock.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
