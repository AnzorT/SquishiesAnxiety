<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console test of the Unity port's Firebase REST client (unity/Assets/Scripts/Backend) against the Local
       Emulator Suite. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/Assets/Scripts/Backend/**/*.cs" Exclude="../../../unity/Assets/Scripts/Backend/Unity/**" />
    <!-- the profile's `stack` record, read the way the game reads it -->
    <Compile Include="../../../unity/Assets/Scripts/Games/Stack/Levels.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Games/Stack/StackXp.cs" />
    <Compile Include="../../../unity/Assets/Scripts/Games/Stack/Js.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
